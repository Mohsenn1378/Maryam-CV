---
import { t, contact, hasUnverified, type Lang } from '../data/content';
import CaseArt from './CaseArt.astro';
import { u } from '../data/url';
const cv = u(contact.cv);
const arts = ['pricing', 'playground', 'agents'] as const;
const orgs = ['Inboxino', 'MagicalAPI', 'Starcoach'];
const logos = ['inboxino', 'magicalapi', 'starcoach'];
const slugs = ['inboxino-pricing', 'magicalapi-playground', 'starcoach-agentic-ai'];
const caseHref = (i: number) => u(`${lang === 'fa' ? '/fa' : ''}/work/${slugs[i]}/`);
const slideLabel = (n: number) => (lang === 'fa' ? `اسلاید ${['۱','۲','۳'][n]} از ۳` : `Slide ${n + 1} of 3`);
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const dev = import.meta.env.DEV;
const otherHref = lang === 'en' ? u('/fa/') : u('/');
const otherLang = lang === 'en' ? 'fa' : 'en';
const s = (verified: boolean) => (verified ? '' : 'sample');
const icon = {
  down: 'M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14',
  arrow: 'M5 12h13m0 0l-5-5m5 5l-5 5',
};
---
<div class={dev ? 'dev' : ''}>
  {dev && hasUnverified && <div class="devbar" role="note">{c.dev.warn}</div>}
  <a class="skip" href="#main">{lang === 'fa' ? 'رفتن به محتوا' : 'Skip to content'}</a>

  <header class="wrap top">
    <a class="brand" href={lang === 'fa' ? u('/fa/') : u('/')}><span class="mark" aria-hidden="true">MR</span>{lang === 'fa' ? 'مریم رجبیان' : 'Maryam Rajabian'}</a>
    <nav class="nav" aria-label={lang === 'fa' ? 'منوی اصلی' : 'Main'}>
      <a href="#work">{c.nav.work}</a><a href="#experience">{c.nav.experience}</a><a href="#how">{c.nav.how}</a><a href="#contact">{c.nav.contact}</a>
    </nav>
    <a class="lang" href={otherHref} hreflang={otherLang} lang={otherLang}>{c.nav.other}</a>
    <a class="btn primary" href={cv} download aria-label={c.nav.cv}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={icon.down}/></svg><span class="long">{c.nav.cv}</span><span class="short" aria-hidden="true">CV</span></a>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="wrap hero" aria-labelledby="h-hero">
      <div class="hero-text">
        <span class="avail"><i aria-hidden="true"></i>{c.hero.status}</span>
        <h1 id="h-hero">{c.hero.title}</h1>
        <p class="lede">{c.hero.lede}</p>
        <div class="ctas">
          <a class="btn primary" href={cv} download>{c.hero.ctaCv}</a>
          <a class="btn" href="#work">{c.hero.ctaWork}</a>
        </div>
        <ul class="proof">
          {c.hero.proof.map((p) => (
            <li><strong class={s(p.verified)}>{p.value}</strong>{p.label}</li>
          ))}
        </ul>
      </div>

      <div class="visual">
        <div class="portrait"><img src={u('/maryam.jpg')} alt={lang === 'fa' ? 'عکس مریم رجبیان' : 'Portrait of Maryam Rajabian'} width="400" height="500" /></div>
      <div class="chatwin" role="group" aria-label={c.hero.chat.label}>
        <div class="cw-top"><span class="av"><img src={u('/maryam.jpg')} alt="" width="40" height="40" /></span><div><strong>{c.hero.chat.name}</strong><small>{c.hero.chat.presence}</small></div></div>
        <div class="chat">
          <p class="msg me m1">{c.hero.chat.q1}</p>
          <span class="typing t1" aria-hidden="true"><i></i><i></i><i></i></span>
          <p class="msg her m2">{c.hero.chat.a1}</p>
          <p class="msg me m3">{c.hero.chat.q2}</p>
          <span class="typing t2" aria-hidden="true"><i></i><i></i><i></i></span>
          <p class="msg her m4">{c.hero.chat.a2pre} <b class={s(c.work.cases[0].verified)}>{c.hero.chat.a2num}</b>{c.hero.chat.a2post}</p>
          <div class="chips">
        <a class="chip" href={cv} download><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={icon.down}/></svg>{c.hero.chat.chips.cv}</a>
        <a class="chip" href="#work">{c.hero.chat.chips.work}</a>
        <a class="chip" href={`mailto:${contact.email}`}>{c.hero.chat.chips.email}</a>
      </div>
        </div>
      </div>
      </div>
    </section>

    <!-- WORK -->
    <section class="wrap block" id="work" aria-labelledby="h-work">
      <h2 id="h-work">{c.work.title}</h2>
      <p class="sub">{c.work.sub}</p>
      <div class="cases">
        {c.work.cases.map((k, i) => (
          <article class="case">
            <div class="slider" data-slider>
              {[0, 1, 2].map((n) => (
                <div class={n === 0 ? 'slide on' : 'slide'} aria-hidden="true"><CaseArt kind={arts[i]} n={n as 0 | 1 | 2} /></div>
              ))}
              <span class="org-badge" lang="en"><img src={u(`/logos/${logos[i]}.png`)} alt="" width="22" height="22" loading="lazy" />{orgs[i]}</span>
              <div class="dots">
                {[0, 1, 2].map((n) => (
                  <button type="button" class={n === 0 ? 'dot on' : 'dot'} data-go={n} aria-label={slideLabel(n)} aria-pressed={n === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
            </div>
            <span class="meta">{k.meta}</span>
            <h3>{k.title}</h3>
            <p>{k.body} <strong class={s(k.verified)}>{k.num}</strong>{k.after}</p>
            <a class="more" href={caseHref(i)}>{c.work.read}<svg class="mirror" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={icon.arrow}/></svg></a>
          </article>
        ))}
      </div>
      <h3 class="others-title">{c.work.othersTitle}</h3>
      <ul class="others">
        {c.work.others.map((o) => <li><b>{o.title}</b><span>{o.where}</span></li>)}
      </ul>
    </section>

    <!-- EXPERIENCE -->
    <section class="wrap block" id="experience" aria-labelledby="h-exp">
      <h2 id="h-exp">{c.experience.title}</h2>
      <ol class="roles">
        {c.experience.roles.map((r) => (
          <li class="role">
            <div class="role-head">
              <div><h3>{r.role}</h3><span class="org">{r.org}</span></div>
              <span class="when">{r.when}{lang === 'fa' ? '، ' : ', '}{r.where}</span>
            </div>
            <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ol>
      <div class="earlier">
        <h3>{c.experience.earlierTitle}</h3>
        <ul>{c.experience.earlier.map((e) => <li><span>{e.role}{lang === 'fa' ? '، ' : ', '}{e.org}</span><span class="when">{e.note}</span></li>)}</ul>
      </div>
      <a class="btn" href={cv} download><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={icon.down}/></svg>{c.experience.full}</a>
    </section>

    <!-- HOW I WORK -->
    <section class="wrap block" id="how" aria-labelledby="h-how">
      <h2 id="h-how">{c.how.title}</h2>
      <ul class="how">
        {c.how.items.map((h) => <li><h3>{h.t}</h3><p>{h.d}</p></li>)}
      </ul>
    </section>

    <!-- SKILLS + EDUCATION -->
    <section class="wrap block split" aria-labelledby="h-skills">
      <div>
        <h2 id="h-skills">{c.skills.title}</h2>
        <ul class="tags">{c.skills.skills.map((x) => <li>{x}</li>)}</ul>
        <p class="tools-label">{c.skills.toolsLabel}</p>
        <ul class="tags quiet">{c.skills.tools.map((x) => <li lang="en">{x}</li>)}</ul>
        <p class="langs">{c.skills.langs}</p>
      </div>
      <div>
        <h2>{c.skills.eduTitle}</h2>
        <ul class="edu">
          {c.skills.edu.map((e) => (
            <li>{e.link ? <a href={contact.certificate} rel="noopener" target="_blank"><b>{e.t}</b></a> : <b>{e.t}</b>}<span>{e.s}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="wrap contact" id="contact" aria-labelledby="h-contact">
      <div class="who"><img src={u('/maryam.jpg')} alt={lang === 'fa' ? 'عکس مریم رجبیان' : 'Photo of Maryam Rajabian'} width="72" height="72" loading="lazy" /><div><strong>{lang === 'fa' ? 'مریم رجبیان' : 'Maryam Rajabian'}</strong><span>{lang === 'fa' ? 'مدیر محصول' : 'Product Manager'}</span></div></div>
      <h2 id="h-contact">{c.contact.title}</h2>
      <p>{c.contact.sub}</p>
      <div class="ctas">
        <button class="btn primary" type="button" data-copy={contact.email} data-done={c.contact.copied}>{c.contact.copy}</button>
        <a class="btn" href={contact.linkedin} rel="noopener" target="_blank">{c.contact.linkedin}</a>
        <a class="btn" href={cv} download>{c.contact.cv}</a>
      </div>
      <p class="mail ltr"><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
      <p class="sr" aria-live="polite" id="copy-status"></p>
    </section>
  </main>

  <footer class="wrap foot"><span>{c.footer.updated}</span><span>{c.footer.rights}</span></footer>
</div>

<script>
  // Case sliders: auto-advance every 4.5s, pause on hover/focus/off-screen, swipe, dots; no autoplay with reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((el, idx) => {
    const slides = [...el.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...el.querySelectorAll<HTMLButtonElement>('.dot')];
    let cur = 0, paused = false, visible = true, x0: number | null = null;
    const show = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('on', i === cur));
      dots.forEach((d, i) => { d.classList.toggle('on', i === cur); d.setAttribute('aria-pressed', String(i === cur)); });
    };
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    el.addEventListener('mouseenter', () => (paused = true));
    el.addEventListener('mouseleave', () => (paused = false));
    el.addEventListener('focusin', () => (paused = true));
    el.addEventListener('focusout', () => (paused = false));
    el.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    el.addEventListener('pointerup', (e) => {
      if (x0 === null) return; const dx = e.clientX - x0; x0 = null;
      if (Math.abs(dx) < 40) return;
      const rtl = document.documentElement.dir === 'rtl';
      show(cur + ((dx < 0) !== rtl ? 1 : -1));
    });
    new IntersectionObserver(([en]) => (visible = en.isIntersecting), { threshold: 0.3 }).observe(el);
    if (!reduce) setTimeout(() => setInterval(() => { if (!paused && visible && !document.hidden) show(cur + 1); }, 4500), idx * 700);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { window.location.href = 'mailto:' + b.dataset.copy; return; }
      b.textContent = b.dataset.done!;
      const st = document.getElementById('copy-status'); if (st) st.textContent = b.dataset.done!;
      setTimeout(() => (b.textContent = label), 2200);
    });
  });
</script>

<style>
  .top { display: flex; align-items: center; gap: 28px; padding-block: 20px; }
  .brand { font-weight: 800; font-size: 18px; display: flex; align-items: center; gap: 10px; white-space: nowrap; }
  .mark { width: 30px; height: 30px; border-radius: 9px; background: var(--grad); display: grid; place-items: center; color: #fff; font-size: 13px; font-family: 'Plus Jakarta Sans Variable', sans-serif; }
  .nav { display: flex; gap: 26px; margin-inline-start: auto; font-size: 15px; color: var(--mute); }
  .nav a:hover { color: var(--ink); }
  .lang { font-size: 14px; color: var(--mute); border: 1px solid var(--line); border-radius: 8px; padding: 3px 10px; }
  .lang:hover { color: var(--ink); }

  /* hero */
  .hero { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; grid-template-areas: 'text visual'; column-gap: 56px; align-items: center; padding-block: 48px 96px; }
  .hero::before { content: ''; position: absolute; inset-block-start: -40px; inset-inline-end: 0; width: min(620px, 100%); height: 620px; background: radial-gradient(circle, color-mix(in srgb, var(--glow) 28%, transparent), transparent 65%); pointer-events: none; }
  .hero > * { position: relative; }
  .hero-text { grid-area: text; }
  .visual { grid-area: visual; position: relative; display: grid; justify-items: end; padding-block-end: 130px; }
  .portrait { position: relative; width: min(100%, 400px); aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; background: var(--grad); box-shadow: 0 50px 90px -50px #000; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .portrait::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, color-mix(in srgb, var(--bg) 70%, transparent), transparent 45%); }
  .visual .chatwin { position: absolute; inset-inline-start: -8px; inset-block-end: -24px; width: min(310px, 74%); z-index: 2; }
  .visual .chat { min-height: 0; padding: 14px; gap: 8px; }
  .visual .msg { font-size: 13.5px; padding: 8px 12px; }
  .visual .chips { margin-top: 4px; }
  .visual .chip { font-size: 12.5px; padding: 4px 11px; }
  .avail { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--a1); background: color-mix(in srgb, var(--a1) 12%, transparent); border: 1px solid color-mix(in srgb, var(--a1) 30%, transparent); border-radius: 999px; padding: 4px 12px; }
  .avail i { width: 8px; height: 8px; border-radius: 50%; background: var(--a2); animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: .35; } }
  h1 { font-size: 54px; line-height: 1.1; font-weight: 800; letter-spacing: -.025em; margin: 18px 0; }
  :lang(fa) h1 { font-size: 46px; line-height: 1.45; }
  .lede { color: var(--mute); font-size: 1.06em; max-width: 31em; margin: 0 0 30px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .proof { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 32px; color: var(--mute); font-size: 14px; line-height: 1.45; }
  .proof strong { display: block; color: var(--ink); font-size: 24px; font-weight: 800; line-height: 1.3; }

  .chatwin { background: color-mix(in srgb, var(--surf) 88%, transparent); backdrop-filter: blur(8px); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; box-shadow: 0 40px 80px -40px #000; }
  .cw-top { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .cw-top small { display: block; color: var(--mute); font-size: 12.5px; line-height: 1.3; }
  .av { width: 40px; height: 40px; border-radius: 50%; background: var(--grad); padding: 2px; position: relative; flex: none; }
  .av img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }
  .av::after { content: ''; position: absolute; inset-block-end: 0; inset-inline-end: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--a2); border: 2px solid var(--surf); }
  .chat { padding: 20px 18px; display: flex; flex-direction: column; gap: 10px; min-height: 330px; }
  .msg { margin: 0; max-width: 84%; padding: 10px 14px; border-radius: 18px; font-size: 15px; line-height: 1.55; opacity: 0; transform: translateY(8px) scale(.98); animation: in .35s forwards; }
  :lang(fa) .msg { line-height: 1.8; }
  .me { align-self: flex-end; background: var(--grad); color: #fff; border-end-end-radius: 6px; font-weight: 500; }
  .her { align-self: flex-start; background: var(--bg2); border: 1px solid var(--line); border-end-start-radius: 6px; }
  .her b { color: var(--a2); }
  .typing { align-self: flex-start; display: flex; gap: 4px; padding: 12px 14px; background: var(--bg2); border: 1px solid var(--line); border-radius: 18px; opacity: 0; animation: in .2s forwards, out .2s forwards; }
  .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--mute); animation: dot 1s infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes dot { 50% { transform: translateY(-3px); opacity: .4; } }
  .m1 { animation-delay: .3s; } .t1 { animation-delay: .8s, 1.5s; } .m2 { animation-delay: 1.55s; }
  .m3 { animation-delay: 2.4s; } .t2 { animation-delay: 2.9s, 3.6s; } .m4 { animation-delay: 3.65s; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; opacity: 0; animation: in .35s 4.2s forwards; }
  .chip { font-size: 14px; font-weight: 700; border: 1px solid var(--a2); color: var(--a2); border-radius: 999px; padding: 6px 14px; display: inline-flex; gap: 6px; align-items: center; transition: background .2s; }
  .chip:hover { background: color-mix(in srgb, var(--a2) 14%, transparent); }
  .chip svg { width: 15px; height: 15px; }
  @keyframes in { to { opacity: 1; transform: none; } }
  @keyframes out { to { opacity: 0; height: 0; padding: 0; margin: -5px 0; border-width: 0; } }

  /* blocks */
  .block { padding-block: 88px 8px; }
  .block h2, .contact h2 { font-size: 34px; font-weight: 800; letter-spacing: -.02em; line-height: 1.25; margin-bottom: 8px; }
  :lang(fa) .block h2, :lang(fa) .contact h2 { font-size: 30px; line-height: 1.5; }
  .sub { color: var(--mute); margin: 0 0 34px; }

  .cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .case { background: var(--surf); border: 1px solid var(--line); border-radius: 22px; padding: 16px 16px 24px; display: flex; flex-direction: column; gap: 10px; }
  .case > :not(.slider) { margin-inline: 8px; }
  .slider { position: relative; aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; margin-bottom: 8px; border: 1px solid var(--line); background: radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--g2) 14%, var(--bg2)), var(--bg2)); touch-action: pan-y; }
  .slide { position: absolute; inset: 0; padding: 40px 16px 30px; opacity: 0; transform: translateX(14px); transition: opacity .5s ease, transform .5s ease; }
  [dir='rtl'] .slide { transform: translateX(-14px); }
  .slide.on { opacity: 1; transform: none; }
  .org-badge { position: absolute; inset-block-start: 10px; inset-inline-start: 10px; display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; color: var(--ink); background: color-mix(in srgb, var(--surf) 88%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px 3px 3px; z-index: 2; }
  [dir='rtl'] .org-badge { padding: 3px 3px 3px 10px; }
  .org-badge img { width: 22px; height: 22px; border-radius: 50%; background: #fff; object-fit: cover; }
  .dots { position: absolute; inset-block-end: 6px; inset-inline: 0; display: flex; justify-content: center; gap: 2px; z-index: 2; }
  .dot { width: 22px; height: 22px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .dot::after { content: ''; width: 7px; height: 7px; border-radius: 99px; background: var(--line); transition: width .3s, background .3s; }
  .dot.on::after { width: 18px; background: var(--a2); }
  .dot:hover::after { background: var(--mute); }
  .dot.on:hover::after { background: var(--a2); }
  .meta { font-size: 13.5px; color: var(--mute); }
  .case h3 { font-size: 21px; line-height: 1.35; font-weight: 800; }
  :lang(fa) .case h3 { line-height: 1.6; }
  .case p { margin: 0; color: var(--mute); font-size: 15px; }
  .case p strong { color: var(--a2); }
  .more { margin-top: auto; padding-top: 8px; font-weight: 700; font-size: 15px; color: var(--a2); display: inline-flex; gap: 6px; align-items: center; }
  .more svg { width: 16px; height: 16px; }
  .others-title { font-size: 16px; color: var(--mute); font-weight: 600; margin: 36px 0 4px; }
  .others { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 40px; border-top: 1px solid var(--line); }
  .others li { display: flex; justify-content: space-between; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .others b { font-weight: 700; font-size: 15.5px; }
  .others span { color: var(--mute); font-size: 14px; text-align: end; }

  .roles { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 14px; }
  .role { background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 22px 26px; }
  .role-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: baseline; }
  .role h3 { font-size: 19px; font-weight: 800; }
  .org { color: var(--a2); font-weight: 700; }
  .when { color: var(--mute); font-size: 14px; }
  .role ul { margin: 10px 0 0; padding-inline-start: 20px; color: var(--mute); font-size: 15.5px; }
  .role li + li { margin-top: 4px; }
  .earlier { margin: 18px 0 22px; border: 1px dashed var(--line); border-radius: 18px; padding: 16px 26px; }
  .earlier h3 { font-size: 15px; color: var(--mute); font-weight: 600; margin-bottom: 6px; }
  .earlier ul { list-style: none; padding: 0; margin: 0; }
  .earlier li { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 4px 0; font-size: 15.5px; }

  .how { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-block: 1px solid var(--line); }
  .how li { padding: 24px 22px 26px; }
  .how li + li { border-inline-start: 1px solid var(--line); }
  .how h3 { font-size: 17px; font-weight: 800; margin-bottom: 8px; }
