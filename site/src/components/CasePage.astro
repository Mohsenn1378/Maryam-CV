---
import CaseArt from './CaseArt.astro';
import { cases, caseUi } from '../data/cases';
import { contact, type Lang } from '../data/content';
import { u } from '../data/url';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const list = cases[lang];
const i = list.findIndex((c) => c.slug === slug);
const k = list[i];
const next = list[(i + 1) % list.length];
const ui = caseUi[lang];
const pre = lang === 'fa' ? '/fa' : '';
const home = u(`${pre}/`);
// split "text ⟦placeholder⟧ text" into segments
const seg = (s: string) => s.split(/(⟦[^⟧]*⟧)/).filter(Boolean).map((p) => ({ todo: p.startsWith('⟦'), t: p.replace(/[⟦⟧]/g, '') }));
const other = lang === 'en' ? u(`/fa/work/${slug}/`) : u(`/work/${slug}/`);
const arrow = 'M5 12h13m0 0l-5-5m5 5l-5 5';
---
<header class="wrap top">
  <a class="back" href={`${home}#work`}><svg class="mirror flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={arrow} /></svg>{ui.back}</a>
  <a class="lang" href={other} hreflang={lang === 'en' ? 'fa' : 'en'} lang={lang === 'en' ? 'fa' : 'en'}>{lang === 'en' ? 'فارسی' : 'English'}</a>
  <a class="btn primary" href={u(contact.cv)} download>{ui.cv}</a>
</header>

<main id="main" class="wrap case-page">
  <p class="org"><img src={u(`/logos/${k.logo}.png`)} alt="" width="28" height="28" /><span lang="en">{k.org}</span><span class="meta">{k.meta}</span></p>
  <h1>{k.title}</h1>
  <p class="tldr">{seg(k.tldr).map((p) => (p.todo ? <mark class="todo" title={ui.todo}>{p.t}</mark> : p.t))}</p>

  <div class="gallery" aria-hidden="true">
    {[0, 1, 2].map((n) => <div class="shot"><CaseArt kind={k.art} n={n as 0 | 1 | 2} /></div>)}
  </div>

  <div class="body">
    <section><h2>{ui.context}</h2><ul>{k.context.map((c) => <li>{seg(c).map((p) => (p.todo ? <mark class="todo">{p.t}</mark> : p.t))}</li>)}</ul></section>
    <section><h2>{ui.problem}</h2><ul>{k.problem.map((c) => <li>{seg(c).map((p) => (p.todo ? <mark class="todo">{p.t}</mark> : p.t))}</li>)}</ul></section>
    <section><h2>{ui.did}</h2>
      <ol class="steps">{k.did.map((d) => <li><h3>{d.t}</h3><p>{seg(d.d).map((p) => (p.todo ? <mark class="todo">{p.t}</mark> : p.t))}</p></li>)}</ol>
    </section>
    <section class="callout"><h2>{ui.notBuilt}</h2><p>{seg(k.notBuilt).map((p) => (p.todo ? <mark class="todo">{p.t}</mark> : p.t))}</p></section>
    <section><h2>{ui.outcome}</h2><ul class="outcome">{k.outcome.map((c) => <li>{seg(c).map((p) => (p.todo ? <mark class="todo">{p.t}</mark> : p.t))}</li>)}</ul></section>
    <section><h2>{ui.again}</h2><p>{seg(k.again).map((p) => (p.todo ? <mark class="todo">{p.t}</mark> : p.t))}</p></section>
  </div>

  <nav class="next" aria-label={ui.next}>
    <a href={u(`${pre}/work/${next.slug}/`)}><span>{ui.next}</span><strong>{next.title}</strong><svg class="mirror" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={arrow} /></svg></a>
  </nav>

  <section class="cta">
    <h2>{ui.cta}</h2>
    <div class="ctas"><a class="btn primary" href={`mailto:${contact.email}`}>{ui.email}</a><a class="btn" href={u(contact.cv)} download>{ui.cv}</a></div>
  </section>
</main>

<style>
  .top { display: flex; align-items: center; gap: 16px; padding-block: 20px; }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--mute); font-weight: 600; margin-inline-end: auto; }
  .back:hover { color: var(--ink); }
  .back svg { width: 18px; height: 18px; }
  .flip { transform: scaleX(-1); }
  [dir='rtl'] .flip { transform: none; }
  .lang { font-size: 14px; color: var(--mute); border: 1px solid var(--line); border-radius: 8px; padding: 3px 10px; }
  .case-page { max-width: 860px; padding-block: 24px 40px; }
  .org { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 14px; font-weight: 700; }
  .org img { width: 28px; height: 28px; border-radius: 50%; background: #fff; }
  .org .meta { color: var(--mute); font-weight: 400; font-size: 14px; }
  h1 { font-size: 42px; line-height: 1.15; font-weight: 800; letter-spacing: -.02em; margin-bottom: 18px; }
  :lang(fa) h1 { font-size: 34px; line-height: 1.5; }
  .tldr { font-size: 1.12em; color: var(--ink); border-inline-start: 3px solid var(--a2); padding-inline-start: 16px; margin: 0 0 32px; }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 48px; }
  .shot { aspect-ratio: 16 / 10; border-radius: 14px; border: 1px solid var(--line); background: radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--g2) 14%, var(--bg2)), var(--bg2)); padding: 12px; }
  .body { display: grid; gap: 40px; }
  .body h2 { font-size: 22px; font-weight: 800; margin-bottom: 12px; }
  .body ul { margin: 0; padding-inline-start: 20px; color: var(--mute); display: grid; gap: 6px; }
  .body p { margin: 0; color: var(--mute); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; counter-reset: s; }
  .steps li { background: var(--surf); border: 1px solid var(--line); border-radius: 16px; padding: 16px 20px; }
  .steps h3 { font-size: 16px; font-weight: 800; margin-bottom: 4px; color: var(--ink); }
  .callout { background: color-mix(in srgb, var(--g2) 10%, var(--surf)); border: 1px solid color-mix(in srgb, var(--g2) 35%, var(--line)); border-radius: 18px; padding: 22px 24px; }
  .outcome li { color: var(--ink); font-weight: 600; }
  .todo { background: #3A2E10; color: #FFD98A; border-radius: 6px; padding: 1px 6px; font-weight: 500; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .next { margin-top: 56px; }
  .next a { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 16px; background: var(--surf); border: 1px solid var(--line); border-radius: 18px; padding: 20px 24px; transition: border-color .2s; }
  .next a:hover { border-color: var(--a2); }
  .next span { color: var(--mute); font-size: 14px; grid-column: 1; }
  .next strong { grid-column: 1; font-size: 18px; }
  .next svg { grid-column: 2; grid-row: 1 / 3; width: 22px; height: 22px; color: var(--a2); }
  .cta { margin-top: 40px; text-align: start; }
  .cta h2 { font-size: 24px; font-weight: 800; margin-bottom: 16px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 700px) {
    h1 { font-size: 30px; } :lang(fa) h1 { font-size: 26px; }
    .gallery { grid-template-columns: 1fr; }
    .top .btn { padding: 8px 12px; font-size: 14px; }
  }
</style>
