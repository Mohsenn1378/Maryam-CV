---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
import type { Lang } from '../data/content';
import { u } from '../data/url';

interface Props { lang: Lang; title: string; description: string }
const { lang, title, description } = Astro.props;
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const site = Astro.site ?? new URL('https://example.com');
const enUrl = new URL(u('/'), site).href;
const faUrl = new URL(u('/fa/'), site).href;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E1923" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fa" href={faUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={new URL(u('/maryam.jpg'), site).href} />
    <meta property="og:url" content={lang === 'fa' ? faUrl : enUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
