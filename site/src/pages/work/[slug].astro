---
import Base from '../../layouts/Base.astro';
import CasePage from '../../components/CasePage.astro';
import { cases } from '../../data/cases';
export function getStaticPaths() {
  return cases.en.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const k = cases.en.find((c) => c.slug === slug)!;
---
<Base lang="en" title={`${k.title} — Maryam Rajabian`} description={k.tldr.replace(/⟦[^⟧]*⟧/g, '').trim()}><CasePage lang="en" slug={slug!} /></Base>
